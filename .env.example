# NexusRoute server configuration — copy to .env and fill in real values.
# .env is git-ignored and must never be committed to the repository.

# --- LLM Provider Keys ------------------------------------------------------
# Required for real Gemini cloud-model responses. Without it, the server
# serves deterministic built-in fallbacks (no key required for local dev).
GEMINI_API_KEY=""

# Required for the Groq LPU copilot chatbot. Without it, chat uses the
# Gemini fallback or a deterministic built-in response.
GROQ_API_KEY=""

# --- Server -----------------------------------------------------------------
# Port the Express server listens on (default: 3001).
PORT=3001

# Set to "production" to serve the built dist/ bundle instead of Vite dev.
NODE_ENV=development

# --- Authentication ----------------------------------------------------------
# Password for the two seeded demo accounts (lead.engineer@acme-enterprise.io,
# alex.vance@cloud-vertex.ai). Change this in any shared deployment.
DEMO_PASSWORD="demo1234"

# Session lifetime in minutes (default: 480 = 8 hours). Sessions are stored
# as SHA-256 hashes and destroyed server-side on logout.
SESSION_TTL_MINUTES="480"

# Demo SSO endpoint (POST /api/auth/demo-sso) — issues sessions for the seeded
# demo account. Always allowed in development; DISABLED in production unless
# this is explicitly set to "true".
DEMO_SSO_ENABLED="false"

# Absolute path of the SQLite database that stores users and sessions.
# Defaults to <projectRoot>/nexusroute.db.
AUTH_DB_PATH="./nexusroute.db"

# --- Load Management ----------------------------------------------------------
# Max concurrent API requests before the server sheds load with 503 (default: 40).
LOAD_MAX_CONCURRENT="40"

# Max concurrent model (LLM) executions; extras wait in a bounded queue (default: 8).
LOAD_LLM_CONCURRENT="8"

# Max queued LLM requests waiting for a slot (default: 20); overflow -> 503 LLM_BUSY.
LOAD_LLM_QUEUE="20"

# Milliseconds a queued LLM request waits before being rejected (default: 5000).
LOAD_LLM_ACQUIRE_TIMEOUT_MS="5000"

# Analysis cache (default: 200 entries, 60s TTL) — repeated identical analyses skip recompute.
LOAD_CACHE_MAX_ENTRIES="200"
LOAD_CACHE_TTL_MS="60000"

# --- ONNX Routing Classifier -------------------------------------------------
# Path to the INT8-quantized router model. Falls back to heuristic scoring
# when the file is missing.
ONNX_MODEL_PATH="C:/Users/muthu raman/Downloads/nexusroute_router_int8.onnx"

# --- Links ------------------------------------------------------------------
# Public URL the app is hosted at (used for sitemap/robots/SEO entries).
APP_URL="https://nexusroute.ai"
